{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "storybook-static/**"],
      "env": [
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_KLAYR_SERVICE_API_VERSION",
        "NEXT_PUBLIC_KLAYR_SERVICE_MAINNET",
        "NEXT_PUBLIC_KLAYR_SERVICE_TESTNET",
        "NEXT_PUBLIC_KLAYR_EXPLORER_URL"
      ]
    },
    "lint": {},
    "type-check": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
